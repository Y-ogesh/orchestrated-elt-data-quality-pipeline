# Runtime
APP_ENV=local
LOG_LEVEL=INFO
OLIST_RAW_DIR=data/raw
OLIST_PROFILE_PATH=reports/data_profile.json
OLIST_SOURCE_VERSION=kaggle-v2-2021-10-01

# AWS (use an AWS profile or workload identity; do not store keys here)
AWS_PROFILE=
AWS_REGION=us-east-1
S3_BUCKET=
S3_RAW_PREFIX=olist/raw
OLIST_RUN_AWS_INTEGRATION=0

# Snowflake (prefer key-pair/OAuth authentication)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ELT_TRANSFORMER
SNOWFLAKE_WAREHOUSE=ELT_WH
SNOWFLAKE_DATABASE=OLIST_ANALYTICS
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_STORAGE_INTEGRATION=
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_STAGING_SCHEMA=STAGING
SNOWFLAKE_INTERMEDIATE_SCHEMA=INTERMEDIATE
SNOWFLAKE_MARTS_SCHEMA=MARTS
SNOWFLAKE_AUDIT_SCHEMA=AUDIT
SNOWFLAKE_FILE_FORMAT=OLIST_CSV_FORMAT
SNOWFLAKE_STAGE=OLIST_RAW_STAGE
OLIST_RUN_SNOWFLAKE_INTEGRATION=0

# dbt (development targets are isolated as <DBT_DEV_SCHEMA>_<layer>)
DBT_DEV_SCHEMA=DBT_DEV
DBT_PROFILES_DIR=dbt
DBT_ENV_SECRET_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
